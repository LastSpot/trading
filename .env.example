# Copy to .env and fill in your values. Never commit .env.

# Paper — R50d (daily trend book). Use a dedicated Alpaca paper key pair.
ALPACA_PAPER_R50D_KEY=
ALPACA_PAPER_R50D_SECRET=

# Paper — R50d_asym A/B (asymmetric TQQQ gate). Separate Alpaca paper account.
ALPACA_PAPER_R50D_ASYM_KEY=
ALPACA_PAPER_R50D_ASYM_SECRET=

# Paper — DM42 (weekly dual momentum). Separate Alpaca paper account/keys required.
ALPACA_PAPER_DM42_KEY=
ALPACA_PAPER_DM42_SECRET=

# Live — only after promotion (real money); requires --confirm-live
# ALPACA_LIVE_R50D_KEY=
# ALPACA_LIVE_R50D_SECRET=

# Optional: emails the run summary (Gmail app password, not your login password).
GMAIL_USER=
GMAIL_APP_PASSWORD=
